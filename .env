PORT=3000
SESSION_SECRET=flexi_bat_code_sercret_site_web

# Connexion PostgreSQL — Railway fournit cette variable automatiquement
# si tu ajoutes un plugin PostgreSQL à ton projet. En local, installe
# PostgreSQL et crée une base, puis renseigne son URL ici.
DATABASE_URL=postgresql://postgres:1234@localhost:5432/flexibat



PORT=3000
SESSION_SECRET=change-moi-par-une-longue-chaine-aleatoire

# Connexion PostgreSQL — Railway fournit cette variable automatiquement
# si tu ajoutes un plugin PostgreSQL à ton projet. En local, installe
# PostgreSQL et crée une base, puis renseigne son URL ici.
DATABASE_URL=postgresql://user:password@localhost:5432/flexibat

# Envoi d'email pour le formulaire de contact — OBLIGATOIRE.
# Les messages ne sont pas enregistrés en base : sans ces variables,
# le formulaire de contact du site refusera les envois (erreur 503).
#
# Avec Gmail (solution rapide en attendant l'email pro @flexibat.ci) :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tonadresse@gmail.com
#   SMTP_PASS=mot-de-passe-application-a-16-caracteres (PAS ton mot de passe Gmail normal —
#     à générer sur https://myaccount.google.com/apppasswords, nécessite la validation en 2 étapes)
#   SMTP_FROM=tonadresse@gmail.com
#
# Avec une adresse pro (une fois flexibat.ci configuré chez ton hébergeur) :
#   SMTP_HOST=mail.flexibat.ci (ou le host SMTP donné par ton hébergeur)
#   SMTP_PORT=465
#   SMTP_USER=contact@flexibat.ci
#   SMTP_PASS=le-mot-de-passe-de-cette-boite-mail
#   SMTP_FROM=contact@flexibat.ci
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=charliatse28@gmail.com
SMTP_PASS=
SMTP_FROM=charliatse28@gmail.com
